+
+    /// A child killed while holding a borrowed token must not shrink the
+    /// pool for later compiles (#2874).
+    #[test]
+    #[cfg(unix)]
+    fn killed_child_does_not_leak_jobserver_tokens() {
+        use std::os::unix::process::ExitStatusExt;
+        let runtime = tokio::runtime::Runtime::new().unwrap();
+        runtime.block_on(async {
+            let client = Client::new_num(2);
+            let mut creator = <ProcessCommandCreator as CommandCreator>::new(&client);
+            let mut cmd = creator.new_command("/bin/sh");
+            // Borrow the pool's other token, then die by a signal.
+            cmd.args(&[
+                "-c",
+                r#"a=${CARGO_MAKEFLAGS##*--jobserver-auth=}; eval "head -c1 <&${a%,*}" >/dev/null; kill -9 $$"#,
+            ]);
+            cmd.share_jobserver();
+            let status = cmd.spawn().await.unwrap().wait().await.unwrap();
+            assert_eq!(status.signal(), Some(9));
+
+            let both = async { (client.acquire().await, client.acquire().await) };
+            let (a, b) = tokio::time::timeout(std::time::Duration::from_secs(10), both)
+                .await
+                .expect("the killed child's token was never replaced");
+            a.unwrap();
+            b.unwrap();
+        });
+    }
