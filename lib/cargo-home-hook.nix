# mkCargoHomeHook :: { pkgs, cargoConfig } -> shell hook string
#
# Install a generated Cargo config as CARGO_HOME. An inherited CARGO_HOME is
# kept unless it is another harbor-rs generated config, whose channel or
# targets need not match this shell (stable cargo rejects nightly -Z flags).
{
  pkgs,
  cargoConfig,
}:
if cargoConfig != null
then ''
  __rs_harbor_cfg_hash="$(${pkgs.coreutils}/bin/sha256sum ${cargoConfig.configPath} | ${pkgs.coreutils}/bin/cut -c1-16)"
  RS_HARBOR_CARGO_HOME="''${XDG_CACHE_HOME:-$HOME/.cache}/harbor-rs/cargo-config-$__rs_harbor_cfg_hash"
  case "''${CARGO_HOME:-}" in
    "" | "''${XDG_CACHE_HOME:-$HOME/.cache}"/harbor-rs/cargo-config-*)
      export CARGO_HOME="$RS_HARBOR_CARGO_HOME"
      ;;
  esac
  # In CI, a preset CARGO_HOME (the runner's cached one) lends its
  # registry, git checkouts, binaries and credentials to a private Cargo
  # home that holds the generated config. Writing the config into the
  # shared home would leak this shell's linker and -Z flags into every
  # later step of the job, including shells without mold or on another
  # channel. A project's own config is never overridden, and outside CI a
  # developer's global CARGO_HOME is kept as is.
  # ponytail: Cargo's package-cache lock is per home, so concurrent cargo
  # runs from different private homes do not lock the shared registry;
  # CI steps run sequentially. Lock through one home if that changes.
  if [ "$CARGO_HOME" != "$RS_HARBOR_CARGO_HOME" ] \
    && [ -n "''${CI:-}" ] && [ ! -e "$CARGO_HOME/config" ] && {
      [ ! -e "$CARGO_HOME/config.toml" ] \
        || [ "$(${pkgs.coreutils}/bin/head -n1 "$CARGO_HOME/config.toml")" = "# Generated by harbor-rs — https://github.com/caniko/harbor-rs" ]
    }; then
    mkdir -p "$RS_HARBOR_CARGO_HOME" "$CARGO_HOME/registry" "$CARGO_HOME/git" "$CARGO_HOME/bin" || return 1
    for __rs_harbor_entry in registry git bin credentials.toml credentials; do
      if [ -e "$CARGO_HOME/$__rs_harbor_entry" ] && {
        [ -L "$RS_HARBOR_CARGO_HOME/$__rs_harbor_entry" ] || [ ! -e "$RS_HARBOR_CARGO_HOME/$__rs_harbor_entry" ]
      }; then
        ln -sfnT "$CARGO_HOME/$__rs_harbor_entry" "$RS_HARBOR_CARGO_HOME/$__rs_harbor_entry" || return 1
      fi
    done
    export CARGO_HOME="$RS_HARBOR_CARGO_HOME"
  fi
  if [ "$CARGO_HOME" = "$RS_HARBOR_CARGO_HOME" ]; then
    mkdir -p "$CARGO_HOME" || return 1
    # Concurrent direnv shells must not unlink or expose a partial config.
    __rs_harbor_cfg_tmp="$(mktemp "$CARGO_HOME/.config.toml.XXXXXX")" || return 1
    if ! install -m 0644 ${cargoConfig.configPath} "$__rs_harbor_cfg_tmp" \
      || ! ${pkgs.coreutils}/bin/mv -fT "$__rs_harbor_cfg_tmp" "$CARGO_HOME/config.toml"; then
      rm -f "$__rs_harbor_cfg_tmp"
      return 1
    fi
    echo "harbor-rs: cargo config at $CARGO_HOME/config.toml" >&2
  else
    echo "harbor-rs: keeping existing CARGO_HOME=$CARGO_HOME; generated Cargo config is not activated" >&2
  fi
''
else ""
